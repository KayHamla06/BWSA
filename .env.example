# ===================================
# ChatCommerce OS - Environment Variables
# ===================================

# Application
NODE_ENV=production
APP_URL=https://your-domain.com
PORT=3000
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://localhost:27017/chatcommerce
# For Docker Compose:
# MONGODB_URI=mongodb://admin:changeme@mongodb:27017/chatcommerce?authSource=admin
MONGO_USERNAME=admin
MONGO_PASSWORD=changeme_secure_password

# JWT Authentication
JWT_SECRET=your_super_secure_jwt_secret_key_change_this
REFRESH_TOKEN_SECRET=your_super_secure_refresh_token_secret_key_change_this
BANK_ENCRYPTION_KEY=your_32_plus_character_bank_encryption_key
LEDGER_SECRET_KEY=your_double_entry_ledger_secret_key
FINANCE_ADMIN_EMAILS=finance-admin@your-domain.com

# PayFast Payment Gateway
PAYFAST_MERCHANT_ID=your_platform_payfast_merchant_id
PAYFAST_MERCHANT_KEY=your_platform_payfast_merchant_key
PAYFAST_PASSPHRASE=your_platform_payfast_passphrase
PAYFAST_SANDBOX=true

# WhatsApp Business API
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_TOKEN=your_whatsapp_api_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Email Service (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Render Deployment
# Set these in Render dashboard instead
# RENDER=true
